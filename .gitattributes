# Let Git decide what is text, store it with LF in the repository, and check
# it out with the platform's own line endings. This is what silences the
# "LF will be replaced by CRLF" warnings on a Windows clone without touching
# what is already stored.
* text=auto

# Sources, so the rule is explicit rather than guessed.
*.c     text
*.h     text
*.cpp   text
*.hpp   text
*.md    text
*.txt   text
*.csv   text
*.json  text
*.yml   text
*.yaml  text

# Shell scripts must stay LF or the shebang breaks.
*.sh    text eol=lf

# STM32CubeMX project file: text, but never reformatted by anyone.
*.ioc   text

# Binary: never diffed, never converted.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.zip   binary
*.bin   binary
*.elf   binary
*.hex   binary
*.sal   binary

# ---------------------------------------------------------------------------
#  Altium Designer, hardware/
# ---------------------------------------------------------------------------

# Opaque binary containers. Diffing them is meaningless and end-of-line
# conversion would corrupt them.
*.SchDoc  binary
*.PcbDoc  binary
*.SchLib  binary
*.PcbLib  binary
*.IntLib  binary

# The project and the output job are INI-like text, so they stay diffable.
*.PrjPcb  text
*.OutJob  text

# Fabrication data is a byte-exact record of what a fab house received, so it
# is stored exactly as exported: Gerber, Excellon and the reports alike. They
# are text, but a rewritten line ending inside a frozen copy of a physical
# object is a change, not a normalisation.
hardware/*/fabrication/** binary
